rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function isPT() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'pt';
    }

    // --- Validation Helpers ---
    function isValidUser(data) {
      return data.uid == request.auth.uid 
        && data.email is string 
        && data.role in ['pt', 'student']
        && data.keys().hasAll(['uid', 'email', 'role', 'createdAt'])
        && data.keys().size() <= 7;
    }

    function isValidStudentProfile(data) {
      return data.userId is string && data.ptId is string
        && data.status in ['active', 'inactive', 'pending']
        && data.keys().hasAll(['userId', 'ptId', 'status']);
    }

    function isValidPlan(data) {
      return data.title is string && data.title.size() <= 100
        && data.ptId == request.auth.uid
        && data.studentId is string
        && data.status in ['active', 'draft', 'completed'];
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL'])
      );
    }

    match /students/{studentId} {
      allow get: if isSignedIn() && (isOwner(resource.data.userId) || isOwner(resource.data.ptId));
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.ptId == request.auth.uid);
      allow create: if isPT() && isValidStudentProfile(incoming());
      allow update: if isPT() && isOwner(existing().ptId) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'weight', 'height', 'bodyFat', 'objectives', 'trainingLevel'])
      );
    }

    match /plans/{planId} {
      allow get: if isSignedIn() && (isOwner(resource.data.ptId) || isOwner(resource.data.studentId));
      allow list: if isSignedIn() && (resource.data.ptId == request.auth.uid || resource.data.studentId == request.auth.uid);
      allow create: if isPT() && isValidPlan(incoming());
      allow update: if isPT() && isOwner(existing().ptId) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['title', 'status', 'goal', 'endDate'])
      );
    }

    match /workouts/{workoutId} {
      allow read: if isSignedIn();
      allow create: if isPT() && isValidId(incoming().planId);
      allow update, delete: if isPT();
    }

    match /exerciseInstances/{instanceId} {
      allow read: if isSignedIn();
      allow write: if isPT();
    }

    match /logs/{logId} {
      allow read: if isSignedIn() && (resource.data.studentId == request.auth.uid || isPT());
      allow create: if isSignedIn() && incoming().studentId == request.auth.uid;
    }

    match /financials/{recordId} {
      allow read: if isSignedIn() && (resource.data.ptId == request.auth.uid || resource.data.studentId == request.auth.uid);
      allow write: if isPT();
    }
  }
}
